# Zarix — copiar a .env.local. Nunca commitear valores reales.
# Documentación: README.md → Variables de entorno · docs/HANDOFF.md

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En Vercel Production debe ser la origin pública, p.ej. https://zarix-phi.vercel.app
# Sin esto, /auth/callback responde 500 y los OG tags apuntan a localhost.

# --- Supabase (requeridas) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Crons (requerida en prod; sin ella /api/cron/* queda en 401) ---
CRON_SECRET=generate-a-long-random-string

# --- Telegram (requeridas para el bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Metadata + descarga completa: 8000 ms por defecto, máximo 20000.
TELEGRAM_MEDIA_TIMEOUT_MS=8000
# Envío individual de avisos: 5000 ms por defecto, máximo 10000.
TELEGRAM_SEND_TIMEOUT_MS=5000
# Opcional: chat id para alertas de crons rotos
TELEGRAM_ADMIN_CHAT_ID=

# --- Gemini (opcional; fallback del server. El usuario puede BYO-key) ---
GEMINI_API_KEY=
GEMINI_MODEL_FULL=
GEMINI_MODEL_LITE=
# Plazo total por llamada/loop del modelo: 20000 ms, máximo 45000.
GEMINI_TIMEOUT_MS=20000

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_API_BASE_URL=https://api.mercadopago.com
MP_SUBSCRIPTION_AMOUNT=
# Precio explícito requerido. Sin él ni un JSON válido no se crea checkout.
MP_SUBSCRIPTION_CURRENCY=ARS
MP_SUBSCRIPTION_REASON=
MP_SUBSCRIPTION_BACK_URL=
# Alternativa: JSON array de planes (ver lib/billing/plans.ts)
MP_SUBSCRIPTION_PLANS_JSON=

# --- Mercado / FX (opcionales, hay defaults en código) ---
DOLARAPI_URL=
CRIPTOYA_API_URL=
COINGECKO_API_URL=
EXCHANGE_RATE_CACHE_TTL=
# Memoria: 300 s por defecto. Blue para visualización: antigüedad máxima normal de 24 h.
# Las escrituras exigen FX confirmado por proveedor, no stale y de hasta 24 h
# (EXECUTABLE_FX_MAX_AGE_MS); estos ajustes de visualización no amplían ese límite.
EXCHANGE_RATE_MAX_AGE_SECONDS=86400
# Oficial/MEP/CCL: último cierre hasta 96 h; después de 24 h se indica como desactualizado.
# Si ninguna tasa pasa, se muestra la última persistida con su fecha original.
EXCHANGE_RATE_MARKET_MAX_AGE_SECONDS=345600
# Timeout por request a CriptoYa, DolarApi, CoinGecko y Yahoo (milisegundos).
MARKET_DATA_TIMEOUT_MS=8000

# --- Dev only (nunca en production) ---
ALLOW_DEV_LOGIN=false
DEV_LOGIN_SECRET=

# --- Misc ---
# Dedicated fixture UUID only (e.g. 11111111-1111-4111-8111-111111111111). Never the owner account.
COMPARE_USER_ID=

# JWT secret of the Supabase project (Settings → API). Used to mint short-lived
# user-scoped tokens so PAT/MCP/REST queries hit RLS. Never the owner's user id.
# SUPABASE_JWT_SECRET=

# --- Cifrado de secretos de usuario ---
# Production uses Supabase Vault (no extra credential). Do not derive from
# SUPABASE_SERVICE_ROLE_KEY. Local/tests without Vault may set:
# ZARIX_SECRETS_MASTER_KEY=

# --- Auditoría: pimienta para el hash de IP (opcional). ---
# ZARIX_AUDIT_IP_PEPPER=

# --- MCP OAuth 2.1 (off by default). PAT is the supported auth. ---
# ZARIX_MCP_OAUTH_ENABLED=false
# ZARIX_OAUTH_ISSUER=
