digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.35",ranksep="0.55",splines=polyline];
node [fontname="Arial",fontsize=15,shape=plain];
edge [fontname="Arial",fontsize=14,color="#475569",arrowsize=0.8];
label="Clases CU002: cuenta y consulta de saldos"; labelloc=t; fontsize=20;
as [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eef2f6"><B>AccountsService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+create(input: CreateAccountInput): Promise&lt;Account&gt;<BR/>+list(userId: string,<BR/>      options?: {…}): Promise&lt;AccountWithBalance[]&gt;<BR/>+aggregateAccountTotals(accounts: AccountWithBalance[]): AccountAggregates<BR/>+getActiveAccountIds(userId: string): Promise&lt;string[]&gt;<BR/>+listInvestmentAccounts(userId: string): Promise&lt;Account[]&gt;<BR/>+listReferenceAccounts(userId: string): Promise&lt;Array&lt;Pick&lt;Account, 'id' | 'name' | 'currency' | 'balance' | 'type' | 'last_4_digits'&gt;&gt;&gt;<BR/>+listArchived(userId: string): Promise&lt;Account[]&gt;<BR/>+getMulticurrencyBreakdown(userId: string,<BR/>      accountId: string): Promise&lt;{…}&gt;<BR/>+createSecondaryBalanceAdjustment(userId: string,<BR/>      accountId: string,<BR/>      targetSecondaryBalance: number): Promise&lt;void&gt;<BR/>+getById(id: string, userId: string,<BR/>      options?: { includeInactive?: boolean }): Promise&lt;Account | null&gt;<BR/>+correctDebtBalanceSignIfPositive(accountId: string,<BR/>      userId: string): Promise&lt;{ before: number; after: number } | null&gt;<BR/>+sanitizeAccountPatch(body: Record&lt;string, unknown&gt;): Record&lt;string, unknown&gt;<BR/>+update(id: string, userId: string,<BR/>      updates: Record&lt;string, unknown&gt;): Promise&lt;Account&gt;<BR/>+delete(id: string,<BR/>      userId: string): Promise&lt;void&gt;<BR/>+getTotalBalance(userId: string)<BR/>+getTotalBalanceWithInvestments(userId: string)<BR/>+findByName(userId: string,<BR/>      name: string): Promise&lt;Account | null&gt;<BR/>+findByNameFuzzy(userId: string,<BR/>      searchName: string,<BR/>      options?: { currency?: string }): Promise&lt;{…}&gt;</TD></TR></TABLE>>];
cs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eef2f6"><B>CotizacionesService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-dolarProviders: DolarRateProvider[]</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getDolarQuotes(opts?: {…}): Promise&lt;DolarQuotes&gt;<BR/>+getExchangeRate(from: string,<BR/>      to: string = 'ARS'): Promise&lt;number&gt;</TD></TR></TABLE>>];
cai [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>CreateAccountInput</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+userId: string<BR/>+requestId?: string<BR/>+name: string<BR/>+type: string<BR/>+currency: string<BR/>+initialBalance?: number<BR/>+icon?: string<BR/>+color?: string<BR/>+isDebt?: boolean<BR/>+includeInTotal?: boolean<BR/>+includeInLiquid?: boolean<BR/>+minBalance?: number<BR/>+creditLimit?: number<BR/>+closingDay?: number<BR/>+dueDay?: number<BR/>+last4Digits?: string<BR/>+isMulticurrency?: boolean<BR/>+secondaryCurrency?: string</TD></TR></TABLE>>];
ac [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>Account</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+id: string<BR/>+user_id: string<BR/>+name: string<BR/>+type: AccountType<BR/>+currency: string<BR/>+balance: number<BR/>+icon: string | null<BR/>+color: string<BR/>+is_debt: boolean<BR/>+include_in_total: boolean<BR/>+include_in_liquid: boolean<BR/>+min_balance: number | null<BR/>+credit_limit: number | null<BR/>+closing_day: number | null<BR/>+due_day: number | null<BR/>+last_4_digits: string | null<BR/>+is_multicurrency: boolean<BR/>+secondary_currency: string | null<BR/>+sort_order: number<BR/>+is_active: boolean<BR/>+created_at: string<BR/>+updated_at: string</TD></TR></TABLE>>];
awb [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>AccountWithBalance</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+fxUnavailable?: boolean<BR/>+fxStale?: boolean<BR/>+fxAsOf?: string | null<BR/>+balance_usd?: number | null<BR/>+balance_ars_blue?: number | null<BR/>+multicurrency_balance_primary?: number<BR/>+multicurrency_balance_secondary?: number<BR/>+multicurrency_total_usd?: number | null<BR/>+multicurrency_total_ars_blue?: number | null<BR/>+blueReference?: BlueFxReference<BR/>+valuationIssue?: {…}</TD></TR></TABLE>>];
cts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eef2f6"><B>CategoriesService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+list(userId: string): Promise&lt;Category[]&gt;<BR/>+create(input: CreateCategoryInput): Promise&lt;{…}&gt;<BR/>+getById(id: string,<BR/>      userId: string): Promise&lt;Category&gt;<BR/>+update(id: string, userId: string,<BR/>      updates: Partial&lt;CreateCategoryInput&gt;): Promise&lt;Category&gt;<BR/>+delete(id: string,<BR/>      userId: string): Promise&lt;void&gt;</TD></TR></TABLE>>];
cci [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>CreateCategoryInput</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+userId: string<BR/>+name: string<BR/>+type: 'expense' | 'income'<BR/>+icon: string<BR/>+parentId?: string</TD></TR></TABLE>>];
ct [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>Category</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+id: string<BR/>+user_id: string | null<BR/>+name: string<BR/>+type: CategoryType<BR/>+icon: string<BR/>+parent_id: string | null<BR/>+is_system: boolean<BR/>+created_at: string</TD></TR></TABLE>>];
