digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.55",ranksep="0.5",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ROB-CU001: A14 carga de resúmenes y correo"; labelloc=t; fontsize=22;
u [shape=plaintext,fontcolor="#243b53",label="Usuario"];
pm [shape=plaintext,fontcolor="#243b53",label="Proveedor de\ncorreo entrante"];
b17 [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nP17 Carga de resúmenes"];
bw [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nWebhook de correo"];
b13 [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nP13 Bandeja de pendientes"];
bx [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nServicio de extracción"];
va [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nValidarAcceso"];
vb [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nVerificarBuzón"];
ir [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nIngresarResumen"];
ex [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nExtraerMovimientos"];
co [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nConciliarMovimientos"];
gb [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nGestionarBandeja"];
eri [shape=box,style=filled,fillcolor="#dcfce7",label="«entity»\nResumenImportado"];
eip [shape=box,style=filled,fillcolor="#dcfce7",label="«entity»\nÍtemPendiente"];
em [shape=box,style=filled,fillcolor="#dcfce7",label="«entity»\nMovimiento / Cuenta"];
ebz [shape=box,style=filled,fillcolor="#dcfce7",label="«entity»\nBuzónDeIngreso"];
u -> b17 [label="subir PDF/CSV\ny cuenta"];
u -> b13 [label="confirmar /\ndescartar"];
pm -> bw [label="correo\nreenviado"];
b17 -> va [label="identidad"];
b13 -> va [label="identidad"];
bw -> vb [label="secreto y\ndirección"];
vb -> ebz [label="buzón\nactivo"];
vb -> ir [label="correo\nválido"];
b17 -> ir [dir=both,label="archivo\n↔\nestacionados /\nduplicados /\nrechazo"];
ir -> ex [label="leer CSV o\nPDF"];
ex -> bx [dir=both,label="contenido\nenvuelto\n↔\npropuesta"];
ir -> co [label="propuestas"];
co -> em [label="últimos\n120 días"];
ir -> eri [label="documento\nrecibido"];
ir -> eip [label="estacionar\nsin confirmar"];
b13 -> gb [dir=both,label="decisión\n↔\nresultado"];
