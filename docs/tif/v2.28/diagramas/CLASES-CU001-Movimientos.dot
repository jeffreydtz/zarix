tx [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>Transaction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+id: string<BR/>+user_id: string<BR/>+type: TransactionType<BR/>+account_id: string<BR/>+destination_account_id: string | null<BR/>+amount: number<BR/>+currency: string<BR/>+amount_in_account_currency: number<BR/>+destination_amount_in_account_currency?: number | null<BR/>+exchange_rate: number | null<BR/>+category_id: string | null<BR/>+description: string | null<BR/>+notes: string | null<BR/>+tags: string[] | null<BR/>+transaction_date: string<BR/>+receipt_url: string | null<BR/>+location: {…} | null<BR/>+is_recurring: boolean<BR/>+recurring_rule_id: string | null<BR/>+installment_number: number | null<BR/>+installment_total: number | null<BR/>+installment_group_id: string | null<BR/>+source?: 'web' | 'telegram' | 'wallet' | 'api' | 'mcp' | 'email' | 'statement'<BR/>+created_at: string<BR/>+updated_at: string</TD></TR></TABLE>>];
