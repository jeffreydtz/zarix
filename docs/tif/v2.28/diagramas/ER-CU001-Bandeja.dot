digraph G {
graph [rankdir=LR,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: bandeja de pendientes, buzón y tokens"; labelloc=t; fontsize=22;
pending_inbox_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>pending_inbox_items</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">numeric amount NULL</TD></TR><TR><TD ALIGN="LEFT">text currency</TD></TR><TR><TD ALIGN="LEFT">text merchant NULL</TD></TR><TR><TD ALIGN="LEFT">uuid account_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">uuid category_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">timestamptz occurred_at NULL</TD></TR><TR><TD ALIGN="LEFT">text status</TD></TR><TR><TD ALIGN="LEFT">text source</TD></TR><TR><TD ALIGN="LEFT">text direction</TD></TR><TR><TD ALIGN="LEFT">text ingest_key</TD></TR><TR><TD ALIGN="LEFT">text fingerprint</TD></TR><TR><TD ALIGN="LEFT">uuid confirmed_transaction_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">uuid possible_duplicate_of FK NULL</TD></TR></TABLE>>];
inbound_email_mailboxes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>inbound_email_mailboxes</B></TD></TR><TR><TD ALIGN="LEFT">uuid user_id PK,FK</TD></TR><TR><TD ALIGN="LEFT">text token_hash UK</TD></TR><TR><TD ALIGN="LEFT">text token_prefix</TD></TR><TR><TD ALIGN="LEFT">timestamptz created_at</TD></TR><TR><TD ALIGN="LEFT">timestamptz revoked_at NULL</TD></TR></TABLE>>];
wallet_card_account_maps [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>wallet_card_account_maps</B></TD></TR><TR><TD ALIGN="LEFT">uuid user_id PK,FK</TD></TR><TR><TD ALIGN="LEFT">text card_name_normalized PK</TD></TR><TR><TD ALIGN="LEFT">uuid account_id FK</TD></TR></TABLE>>];
personal_access_tokens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>personal_access_tokens</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">text name</TD></TR><TR><TD ALIGN="LEFT">text token_prefix</TD></TR><TR><TD ALIGN="LEFT">text token_hash</TD></TR><TR><TD ALIGN="LEFT">text[] scopes</TD></TR><TR><TD ALIGN="LEFT">timestamptz expires_at</TD></TR><TR><TD ALIGN="LEFT">timestamptz revoked_at NULL</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>accounts</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>transactions</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> pending_inbox_items [dir=none,label="estaciona\nusers 1\npending_inbox_items 0..*"];
accounts -> pending_inbox_items [dir=none,label="cuenta sugerida\naccounts 0..1\npending_inbox_items 0..*"];
pending_inbox_items -> pending_inbox_items [dir=none,label="posible duplicado\n0..1 / 0..*"];
pending_inbox_items -> transactions [dir=none,label="confirmado como (FK user_id,\nconfirmed_transaction_id)\npending_inbox_items 0..*\ntransactions 0..1"];
categories -> pending_inbox_items [dir=none,label="categoría sugerida\ncategories 0..1\npending_inbox_items 0..*"];
users -> inbound_email_mailboxes [dir=none,label="habilita\nusers 1\ninbound_email_mailboxes 0..1"];
users -> wallet_card_account_maps [dir=none,label="asocia tarjeta\nusers 1\nwallet_card_account_maps 0..*"];
accounts -> wallet_card_account_maps [dir=none,label="destino\naccounts 1\nwallet_card_account_maps 0..*"];
users -> personal_access_tokens [dir=none,label="emite\nusers 1\npersonal_access_tokens 0..*"];
}
