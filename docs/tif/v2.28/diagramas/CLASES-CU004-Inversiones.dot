digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.35",ranksep="0.55",splines=polyline];
node [fontname="Arial",fontsize=15,shape=plain];
edge [fontname="Arial",fontsize=14,color="#475569",arrowsize=0.8];
label="Clases CU004: inversión y venta"; labelloc=t; fontsize=20;
is [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eef2f6"><B>InvestmentsService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+create(input: CreateInvestmentInput): Promise&lt;Investment&gt;<BR/>+list(userId: string,<BR/>      options?: { forceRefreshQuotes?: boolean }): Promise&lt;InvestmentWithPnL[]&gt;<BR/>+getById(id: string,<BR/>      userId: string): Promise&lt;Investment&gt;<BR/>+update(id: string, userId: string,<BR/>      updates: PatchInvestmentInput): Promise&lt;Investment&gt;<BR/>+delete(id: string,<BR/>      userId: string): Promise&lt;void&gt;<BR/>+sell(input: SellPositionInput): Promise&lt;SellPositionResult&gt;<BR/>+listSales(userId: string,<BR/>      investmentId?: string): Promise&lt;InvestmentSale[]&gt;<BR/>+recordDailySnapshotForUser(userId: string): Promise&lt;boolean&gt;<BR/>+getPortfolioSummary(userId: string,<BR/>      options?: {…}): Promise&lt;PortfolioSummaryPayload&gt;<BR/>+listPerformanceSnapshots(userId: string,<BR/>      days: number): Promise&lt;Array&lt;{…}&gt;&gt;</TD></TR></TABLE>>];
cs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eef2f6"><B>CotizacionesService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-dolarProviders: DolarRateProvider[]</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getDolarQuotes(opts?: {…}): Promise&lt;DolarQuotes&gt;<BR/>+getExchangeRate(from: string,<BR/>      to: string = 'ARS'): Promise&lt;number&gt;</TD></TR></TABLE>>];
cii [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>CreateInvestmentInput</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+requestId?: string<BR/>+userId: string<BR/>+accountId: string<BR/>+type: InvestmentType<BR/>+ticker?: string<BR/>+name: string<BR/>+quantity: number<BR/>+purchasePrice: number<BR/>+purchaseCurrency: string<BR/>+purchaseDate?: string | null<BR/>+maturityDate?: string<BR/>+interestRate?: number<BR/>+notes?: string<BR/>+marketCurrency?: string<BR/>+paymentCurrency?: string | null<BR/>+law?: string | null<BR/>+isManualPrice?: boolean<BR/>+currentPrice?: number</TD></TR></TABLE>>];
pii [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«type»</FONT><BR/><B>PatchInvestmentInput</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+accountId?: string<BR/>+type?: InvestmentType<BR/>+ticker?: string | null<BR/>+name?: string<BR/>+quantity?: number<BR/>+purchasePrice?: number<BR/>+purchaseCurrency?: string<BR/>+purchaseDate?: string | null<BR/>+maturityDate?: string | null<BR/>+interestRate?: number | null<BR/>+notes?: string<BR/>+marketCurrency?: string | null<BR/>+paymentCurrency?: string | null<BR/>+law?: string | null<BR/>+isManualPrice?: boolean<BR/>+currentPrice?: number | null</TD></TR></TABLE>>];
si [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>SellPositionInput</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+requestId?: string<BR/>+userId: string<BR/>+investmentId: string<BR/>+quantity: number<BR/>+price: number<BR/>+currency: string<BR/>+soldAt?: string<BR/>+notes?: string</TD></TR></TABLE>>];
sr [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>SellPositionResult</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+sale: InvestmentSale<BR/>+remainingQuantity: number<BR/>+positionClosed: boolean</TD></TR></TABLE>>];
iv [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>Investment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+id: string<BR/>+user_id: string<BR/>+account_id: string<BR/>+type: InvestmentType<BR/>+ticker: string | null<BR/>+name: string<BR/>+quantity: number<BR/>+purchase_price: number<BR/>+purchase_currency: string<BR/>+purchase_date: string | null<BR/>+current_price: number | null<BR/>+current_price_updated_at: string | null<BR/>+current_price_change_pct: number | null<BR/>+market_currency: string | null<BR/>+payment_currency: string | null<BR/>+law: string | null<BR/>+is_manual_price: boolean<BR/>+maturity_date: string | null<BR/>+interest_rate: number | null<BR/>+notes: string | null<BR/>+is_active: boolean<BR/>+created_at: string<BR/>+updated_at: string</TD></TR></TABLE>>];
iwp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>InvestmentWithPnL</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+valuation_price_source: 'live' | 'estimate' | 'manual' | 'cache' | 'purchase_reference'<BR/>+current_value_native: number<BR/>+fxUnavailable?: boolean<BR/>+fxStale?: boolean<BR/>+fxAsOf?: string | null<BR/>+current_value: number | null<BR/>+profit_loss: number | null<BR/>+profit_loss_percent: number | null<BR/>+market_price_currency: string<BR/>+cost_basis_usd: number | null<BR/>+market_value_usd: number | null<BR/>+profit_loss_usd: number | null<BR/>+profit_loss_percent_usd: number | null<BR/>+market_value_ars_blue: number | null<BR/>+daily_change_pct: number | null<BR/>+daily_pnl_usd: number | null<BR/>+realized_pnl_usd: number<BR/>+sales_count: number</TD></TR></TABLE>>];
isl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>InvestmentSale</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+id: string<BR/>+user_id: string<BR/>+investment_id: string<BR/>+quantity: number<BR/>+price: number<BR/>+currency: string<BR/>+sold_at: string<BR/>+purchase_price_at_sale: number<BR/>+realized_pnl_native: number<BR/>+realized_pnl_usd: number<BR/>+ars_per_usd: number<BR/>+notes: string | null<BR/>+created_at: string</TD></TR></TABLE>>];
psp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f1f5f9"><FONT POINT-SIZE="14">«interface»</FONT><BR/><B>PortfolioSummaryPayload</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+investments: InvestmentWithPnL[]<BR/>+fxUnavailable?: boolean<BR/>+fxStale?: boolean<BR/>+fxAsOf?: string | null<BR/>+totalCurrentValue: number | null<BR/>+totalPurchaseValue: number | null<BR/>+totalPnL: number | null<BR/>+totalPnLPercent: number | null<BR/>+blueArsPerUsd: number | null<BR/>+blueReference?: BlueFxReference<BR/>+totalCurrentValueArsBlue: number | null<BR/>+totalPurchaseValueArsBlue: number | null<BR/>+totalPnLArsBlue: number | null<BR/>+totalDailyPnLUsd: number | null<BR/>+totalDailyPnLPercent: number | null<BR/>+totalDailyPnLArsBlue: number | null<BR/>+totalRealizedPnLUsd: number<BR/>+totalRealizedPnLArsBlue: number | null<BR/>+byType: Array&lt;{…}&gt;<BR/>+byCurrency: Array&lt;{…}&gt;<BR/>+weeklyChange: PeriodChange | null<BR/>+monthlyChange: PeriodChange | null<BR/>+topGainers: Array&lt;{…}&gt;<BR/>+topLosers: Array&lt;{…}&gt;</TD></TR></TABLE>>];
is -> cs [style=dashed,arrowhead=vee,label="«use» valuación"];
is -> cii [style=dashed,arrowhead=vee,label="«use»"];
