b15 [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nP15 Resumen de tarjeta"];
va [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nValidarAcceso"];
pr [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nProyectarResumenTarjeta"];
