digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: identidad y estado comercial"; labelloc=t; fontsize=22;
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK,FK</TD></TR><TR><TD ALIGN="LEFT">subscription_status status</TD></TR><TR><TD ALIGN="LEFT">text default_currency</TD></TR><TR><TD ALIGN="LEFT">text timezone</TD></TR><TR><TD ALIGN="LEFT">timestamptz current_period_end NULL</TD></TR><TR><TD ALIGN="LEFT">timestamptz grace_period_end NULL</TD></TR><TR><TD ALIGN="LEFT">text mp_preapproval_id NULL</TD></TR></TABLE>>];
