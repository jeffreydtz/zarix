digraph G {
graph [rankdir=LR,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: movimientos y destino exacto"; labelloc=t; fontsize=22;
transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>transactions</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid account_id FK NOT NULL</TD></TR><TR><TD ALIGN="LEFT">uuid destination_account_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">uuid category_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">transaction_type type</TD></TR><TR><TD ALIGN="LEFT">numeric amount</TD></TR><TR><TD ALIGN="LEFT">text currency</TD></TR><TR><TD ALIGN="LEFT">numeric amount_in_account_currency</TD></TR><TR><TD ALIGN="LEFT">numeric destination_amount_in_account_currency NULL</TD></TR><TR><TD ALIGN="LEFT">numeric exchange_rate NULL</TD></TR><TR><TD ALIGN="LEFT">timestamptz transaction_date</TD></TR><TR><TD ALIGN="LEFT">uuid recurring_rule_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">uuid installment_group_id NULL</TD></TR><TR><TD ALIGN="LEFT">integer installment_number NULL</TD></TR><TR><TD ALIGN="LEFT">integer installment_total NULL</TD></TR><TR><TD ALIGN="LEFT">text source NOT NULL (web|telegram|wallet|api|mcp|email|statement)</TD></TR><TR><TD ALIGN="LEFT">UK (user_id, id)</TD></TR></TABLE>>];
accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>accounts</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
recurring_rules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>recurring_rules</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK,FK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> transactions [dir=none,label="registra\nusers 1\ntransactions 0..*"];
accounts -> transactions [dir=none,label="origen\naccounts 1\ntransactions 0..*"];
accounts -> transactions [dir=none,label="destino\naccounts 0..1\ntransactions 0..*"];
categories -> transactions [dir=none,label="clasifica\ncategories 0..1\ntransactions 0..*"];
recurring_rules -> transactions [dir=none,label="genera (FK user_id,\nrecurring_rule_id)\nrecurring_rules 0..1\ntransactions 0..*"];
}
