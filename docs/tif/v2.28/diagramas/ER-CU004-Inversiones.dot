digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: lotes y ventas"; labelloc=t; fontsize=22;
investments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>investments</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid account_id FK</TD></TR><TR><TD ALIGN="LEFT">investment_type type</TD></TR><TR><TD ALIGN="LEFT">text ticker NULL</TD></TR><TR><TD ALIGN="LEFT">text name</TD></TR><TR><TD ALIGN="LEFT">numeric quantity</TD></TR><TR><TD ALIGN="LEFT">numeric purchase_price</TD></TR><TR><TD ALIGN="LEFT">text purchase_currency</TD></TR><TR><TD ALIGN="LEFT">date purchase_date NULL</TD></TR><TR><TD ALIGN="LEFT">numeric current_price NULL</TD></TR><TR><TD ALIGN="LEFT">numeric current_price_change_pct NULL</TD></TR><TR><TD ALIGN="LEFT">timestamptz current_price_updated_at NULL</TD></TR><TR><TD ALIGN="LEFT">text market_currency NULL</TD></TR><TR><TD ALIGN="LEFT">boolean is_manual_price</TD></TR><TR><TD ALIGN="LEFT">text payment_currency NULL</TD></TR><TR><TD ALIGN="LEFT">text law NULL</TD></TR><TR><TD ALIGN="LEFT">date maturity_date NULL</TD></TR><TR><TD ALIGN="LEFT">numeric interest_rate NULL</TD></TR><TR><TD ALIGN="LEFT">text notes NULL</TD></TR><TR><TD ALIGN="LEFT">boolean is_active NULL</TD></TR></TABLE>>];
investment_sales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>investment_sales</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid investment_id FK</TD></TR><TR><TD ALIGN="LEFT">numeric quantity</TD></TR><TR><TD ALIGN="LEFT">numeric price</TD></TR><TR><TD ALIGN="LEFT">text currency</TD></TR><TR><TD ALIGN="LEFT">date sold_at</TD></TR><TR><TD ALIGN="LEFT">numeric purchase_price_at_sale</TD></TR><TR><TD ALIGN="LEFT">numeric realized_pnl_native</TD></TR><TR><TD ALIGN="LEFT">numeric realized_pnl_usd</TD></TR><TR><TD ALIGN="LEFT">numeric ars_per_usd</TD></TR></TABLE>>];
accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>accounts</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK,FK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
accounts -> investments [dir=none,label="contiene\naccounts 1\ninvestments 0..*"];
investments -> investment_sales [dir=none,label="ventas\ninvestments 1\ninvestment_sales 0..*"];
users -> investments [dir=none,label="propietario\nusers 1\ninvestments 0..*"];
users -> investment_sales [dir=none,label="propietario\nusers 1\ninvestment_sales 0..*"];
}
