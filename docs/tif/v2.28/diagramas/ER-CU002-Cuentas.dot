digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: cuentas y categorías"; labelloc=t; fontsize=22;
accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>accounts</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">text name</TD></TR><TR><TD ALIGN="LEFT">account_type type</TD></TR><TR><TD ALIGN="LEFT">text currency</TD></TR><TR><TD ALIGN="LEFT">numeric balance</TD></TR><TR><TD ALIGN="LEFT">boolean is_debt NULL</TD></TR><TR><TD ALIGN="LEFT">boolean include_in_total NULL</TD></TR><TR><TD ALIGN="LEFT">boolean include_in_liquid</TD></TR><TR><TD ALIGN="LEFT">boolean is_multicurrency NULL</TD></TR><TR><TD ALIGN="LEFT">text secondary_currency NULL</TD></TR><TR><TD ALIGN="LEFT">numeric credit_limit NULL</TD></TR><TR><TD ALIGN="LEFT">boolean is_active NULL</TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">uuid parent_id FK NULL</TD></TR><TR><TD ALIGN="LEFT">text name</TD></TR><TR><TD ALIGN="LEFT">category_type type</TD></TR><TR><TD ALIGN="LEFT">boolean is_system NULL</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK,FK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> accounts [dir=none,label="posee\nusers 1\naccounts 0..*"];
users -> categories [dir=none,label="propias o sistema\nusers 0..1\ncategories 0..*"];
categories -> categories [dir=none,label="padre\ncategories 0..1\ncategories 0..*"];
}
