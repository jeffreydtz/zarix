digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.55",ranksep="0.5",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ROB-CU004: A02/A03: precio y respaldo"; labelloc=t; fontsize=22;
u [shape=plaintext,fontcolor="#243b53",label="Usuario"];
bo [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nP09 Portafolio"];
gp [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nPortafolio"];
co [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nCotizaciones"];
bx [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nAdaptador Precios"];
x [shape=plaintext,fontcolor="#243b53",label="Proveedor precios"];
eq [shape=box,style=filled,fillcolor="#dcfce7",label="«entity»\nCotización"];
u -> bo [label="básico / A01–A03"];
bo -> gp [dir=both,label="consultar /\nregistrar lote /\nvender / manual\n↔\nresultado /\nprecio ausente /\nrollback"];
gp -> co [label="precio y fecha"];
co -> bx [dir=both,label="obtener\n↔\nnormalizar"];
bx -> x [dir=both,label="consulta externa\n↔\nprecio / error"];


co -> eq [label="referencia /\nrespaldo"];

}
