digraph G {
graph [rankdir=LR,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: reglas recurrentes"; labelloc=t; fontsize=22;
recurring_rules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>R: recurring_rules</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid account_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid category_id FK</TD></TR><TR><TD ALIGN="LEFT">string type</TD></TR><TR><TD ALIGN="LEFT">string frequency</TD></TR><TR><TD ALIGN="LEFT">numeric amount</TD></TR><TR><TD ALIGN="LEFT">string currency</TD></TR><TR><TD ALIGN="LEFT">date start_date</TD></TR><TR><TD ALIGN="LEFT">date end_date</TD></TR><TR><TD ALIGN="LEFT">date last_executed_date</TD></TR><TR><TD ALIGN="LEFT">boolean is_active</TD></TR><TR><TD ALIGN="LEFT">boolean is_subscription</TD></TR><TR><TD ALIGN="LEFT">boolean notification_enabled</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>U: users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>A: accounts</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>C: categories</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>T: transactions</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> recurring_rules [dir=none,label="configura\nU 1\nR 0..*"];
accounts -> recurring_rules [dir=none,label="utiliza\nA 1\nR 0..*"];
recurring_rules -> transactions [dir=none,label="genera\nR 0..1\nT 0..*"];
categories -> recurring_rules [dir=none,label="clasifica\nC 0..1\nR 0..*"];
}
