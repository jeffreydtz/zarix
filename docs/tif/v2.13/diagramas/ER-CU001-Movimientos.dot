digraph G {
graph [rankdir=LR,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: movimientos y destino exacto"; labelloc=t; fontsize=22;
transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>transactions</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid account_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid destination_account_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid category_id FK</TD></TR><TR><TD ALIGN="LEFT">string type</TD></TR><TR><TD ALIGN="LEFT">numeric amount</TD></TR><TR><TD ALIGN="LEFT">string currency</TD></TR><TR><TD ALIGN="LEFT">numeric amount_in_account_currency</TD></TR><TR><TD ALIGN="LEFT">numeric destination_amount_in_account_currency &quot;nullable historicos&quot;</TD></TR><TR><TD ALIGN="LEFT">numeric exchange_rate</TD></TR><TR><TD ALIGN="LEFT">timestamp transaction_date</TD></TR><TR><TD ALIGN="LEFT">uuid recurring_rule_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid installment_group_id</TD></TR><TR><TD ALIGN="LEFT">integer installment_number</TD></TR><TR><TD ALIGN="LEFT">integer installment_total</TD></TR></TABLE>>];
accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>accounts</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
recurring_rules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>recurring_rules</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> transactions [dir=none,label="registra\nusers 1\ntransactions 0..*"];
accounts -> transactions [dir=none,label="origen\naccounts 1\ntransactions 0..*"];
accounts -> transactions [dir=none,label="destino\naccounts 0..1\ntransactions 0..*"];
categories -> transactions [dir=none,label="clasifica\ncategories 0..1\ntransactions 0..*"];
recurring_rules -> transactions [dir=none,label="genera\nrecurring_rules 0..1\ntransactions 0..*"];
}
