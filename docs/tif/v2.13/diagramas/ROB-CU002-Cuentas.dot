digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.55",ranksep="0.5",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ROB-CU002: Básico, A01/A02/A03: cuentas"; labelloc=t; fontsize=22;
u [shape=plaintext,fontcolor="#243b53",label="Usuario"];
b1 [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nP05 Cuentas"];
au [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nAcceso"];
ac [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nCuentas"];
ec [shape=box,style=filled,fillcolor="#dcfce7",label="«entity»\nCuenta / Saldo"];
eh [shape=box,style=filled,fillcolor="#dcfce7",label="«entity»\nMovimiento / Posición /\nRegla"];
