digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.55",ranksep="0.5",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: historial de patrimonio y portafolio"; labelloc=t; fontsize=22;
portfolio_performance_snapshots [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>portfolio_performance_snapshots</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">date snapshot_date</TD></TR><TR><TD ALIGN="LEFT">numeric cost_basis_usd</TD></TR><TR><TD ALIGN="LEFT">numeric market_value_usd</TD></TR><TR><TD ALIGN="LEFT">numeric unrealized_pnl_usd</TD></TR><TR><TD ALIGN="LEFT">numeric blue_ars_per_usd</TD></TR></TABLE>>];
net_worth_snapshots [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>net_worth_snapshots</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">date snapshot_date</TD></TR><TR><TD ALIGN="LEFT">numeric total_usd</TD></TR><TR><TD ALIGN="LEFT">numeric total_ars_blue</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> portfolio_performance_snapshots [dir=none,label="historial\nusers 1\nportfolio_\nperformance_\nsnapshots 0..*"];
users -> net_worth_snapshots [dir=none,label="patrimonio\nusers 1\nnet_worth_\nsnapshots 0..*"];
}
