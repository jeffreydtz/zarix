digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: sesión bot y referencias"; labelloc=t; fontsize=22;
bot_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>bot_sessions</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">bigint telegram_chat_id</TD></TR><TR><TD ALIGN="LEFT">json context</TD></TR><TR><TD ALIGN="LEFT">timestamp last_message_at</TD></TR></TABLE>>];
exchange_rates [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>exchange_rates</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">string source</TD></TR><TR><TD ALIGN="LEFT">string from_currency</TD></TR><TR><TD ALIGN="LEFT">string to_currency</TD></TR><TR><TD ALIGN="LEFT">numeric rate</TD></TR><TR><TD ALIGN="LEFT">timestamp timestamp</TD></TR></TABLE>>];
market_data_cache [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>market_data_cache</B></TD></TR><TR><TD ALIGN="LEFT">smallint id PK</TD></TR><TR><TD ALIGN="LEFT">json payload</TD></TR><TR><TD ALIGN="LEFT">timestamp updated_at</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> bot_sessions [dir=none,label="conversa\nusers 1\nbot_sessions 0..*"];
}
