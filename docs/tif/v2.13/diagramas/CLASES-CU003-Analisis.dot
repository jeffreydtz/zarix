digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="Clases CU003: análisis determinista"; labelloc=t; fontsize=22;
ApiEntradas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>ApiEntradas</B></TD></TR><TR><TD ALIGN="LEFT">«frontera de análisis»</TD></TR><TR><TD ALIGN="LEFT">rutas HTTP autenticadas</TD></TR></TABLE>>];
Heuristicas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>Heuristicas</B></TD></TR><TR><TD ALIGN="LEFT">«funciones puras»</TD></TR><TR><TD ALIGN="LEFT">+calculateFinancialAnomalies(...)</TD></TR><TR><TD ALIGN="LEFT">+calculateFinancialProjection(...)</TD></TR></TABLE>>];
SupabaseClient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>SupabaseClient</B></TD></TR><TR><TD ALIGN="LEFT">«cliente externo»</TD></TR><TR><TD ALIGN="LEFT">consultas y RPC</TD></TR></TABLE>>];
ApiEntradas -> Heuristicas [style=dashed,label="RF11 sin LLM"];
ApiEntradas -> SupabaseClient [style=dashed,label="datos autorizados por ruta"];
}
