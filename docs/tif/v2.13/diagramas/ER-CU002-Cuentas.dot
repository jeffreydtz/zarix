digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: cuentas y categorías"; labelloc=t; fontsize=22;
accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>accounts</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">string name</TD></TR><TR><TD ALIGN="LEFT">string type</TD></TR><TR><TD ALIGN="LEFT">string currency</TD></TR><TR><TD ALIGN="LEFT">numeric balance</TD></TR><TR><TD ALIGN="LEFT">boolean is_debt</TD></TR><TR><TD ALIGN="LEFT">boolean include_in_total</TD></TR><TR><TD ALIGN="LEFT">boolean include_in_liquid</TD></TR><TR><TD ALIGN="LEFT">boolean is_multicurrency</TD></TR><TR><TD ALIGN="LEFT">string secondary_currency</TD></TR><TR><TD ALIGN="LEFT">numeric credit_limit</TD></TR><TR><TD ALIGN="LEFT">boolean is_active</TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid parent_id FK</TD></TR><TR><TD ALIGN="LEFT">string name</TD></TR><TR><TD ALIGN="LEFT">string type</TD></TR><TR><TD ALIGN="LEFT">boolean is_system</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> accounts [dir=none,label="posee\nusers 1\naccounts 0..*"];
users -> categories [dir=none,label="propias o sistema\nusers 0..1\ncategories 0..*"];
}
