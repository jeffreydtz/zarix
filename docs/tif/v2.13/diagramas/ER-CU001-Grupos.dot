digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="ER: grupo y miembros"; labelloc=t; fontsize=22;
shared_groups [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>shared_groups</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid owner_user_id FK</TD></TR><TR><TD ALIGN="LEFT">string name</TD></TR><TR><TD ALIGN="LEFT">string currency</TD></TR><TR><TD ALIGN="LEFT">string share_token UK</TD></TR><TR><TD ALIGN="LEFT">boolean is_active</TD></TR></TABLE>>];
shared_group_members [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>shared_group_members</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">uuid group_id FK</TD></TR><TR><TD ALIGN="LEFT">uuid user_id FK</TD></TR><TR><TD ALIGN="LEFT">string display_name</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
shared_expenses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f8fafc"><B>shared_expenses</B></TD></TR><TR><TD ALIGN="LEFT">uuid id PK</TD></TR><TR><TD ALIGN="LEFT">contexto</TD></TR></TABLE>>];
users -> shared_groups [dir=none,label="administra\nusers 1\nshared_groups 0..*"];
shared_groups -> shared_group_members [dir=none,label="reune\nshared_groups 1\nshared_group_members 0..*"];
shared_groups -> shared_expenses [dir=none,label="registra\nshared_groups 1\nshared_expenses 0..*"];
shared_group_members -> shared_expenses [dir=none,label="pago\nshared_group_members 1\nshared_expenses 0..*"];
}
