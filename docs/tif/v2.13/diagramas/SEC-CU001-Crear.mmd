%%{init: {"fontSize": 20, "sequence": {"fontSize": 20, "actorMargin": 8, "diagramMarginX": 5, "diagramMarginY": 5, "boxMargin": 8, "boxTextMargin": 8, "noteMargin": 8, "messageMargin": 14, "width": 70, "height": 36, "mirrorActors": false, "useMaxWidth": false, "actorFontSize": 20, "messageFontSize": 20, "noteFontSize": 20, "noteFontFamily": "Arial"}, "themeVariables": {"fontSize": "20px"}, "themeCSS": ".labelText, .loopText { font-size:20px !important; }"}}%%
sequenceDiagram
 actor U as Usuario
 participant B as UI (B)
 participant C as Movim. (C)
 participant Q as FX (C)
 participant D as BD (E)
 participant T as Trigger
 U->>B: Completar movimiento
 B->>C: create(input)
 C->>D: Cuentas propias y<br/>activas
 D-->>C: Origen y destino
 alt Datos o cuentas<br/>inválidos
  C-->>B: Rechazo sin INSERT
 else Datos válidos
  opt Conversión necesaria
   C->>Q: Tasa o override
   Q-->>C: Tasa positiva / error
  end
  alt FX válido o misma moneda
   C->>D: INSERT débito y<br/>destino exacto
   D->>T: NEW
   T->>D: Aplicar débito y<br/>crédito
   alt SQL confirma
    D-->>C: Movimiento con ID
    C-->>B: Confirmación
    B-->>U: Saldo y registro
   else SQL falla
    D-->>C: Rollback completo
    C-->>B: Error
   end
  else FX inválido
   C-->>B: Rechazo sin persistir
  end
 end
