digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="Clases CU004: inversión y venta"; labelloc=t; fontsize=22;
InvestmentsService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>InvestmentsService</B></TD></TR><TR><TD ALIGN="LEFT">+create(...)</TD></TR><TR><TD ALIGN="LEFT">+list(...)</TD></TR><TR><TD ALIGN="LEFT">+sell(...)</TD></TR><TR><TD ALIGN="LEFT">+listSales(...)</TD></TR><TR><TD ALIGN="LEFT">+getPortfolioSummary(...)</TD></TR></TABLE>>];
CotizacionesService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>CotizacionesService</B></TD></TR><TR><TD ALIGN="LEFT">-dolarProviders: DolarRateProvider[]</TD></TR><TR><TD ALIGN="LEFT">+getDolarQuotes(...)</TD></TR><TR><TD ALIGN="LEFT">+getExchangeRate(...)</TD></TR><TR><TD ALIGN="LEFT">+getCryptoQuote(...)</TD></TR></TABLE>>];
SupabaseClient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>SupabaseClient</B></TD></TR><TR><TD ALIGN="LEFT">«cliente externo»</TD></TR><TR><TD ALIGN="LEFT">consultas y RPC</TD></TR></TABLE>>];
InvestmentsService -> CotizacionesService [style=dashed,label="PnL"];
InvestmentsService -> SupabaseClient [style=dashed,label="venta por RPC atómico"];
}
