digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="Clases CU001: gasto compartido"; labelloc=t; fontsize=22;
SharedExpensesService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>SharedExpensesService</B></TD></TR><TR><TD ALIGN="LEFT">+createGroup(...)</TD></TR><TR><TD ALIGN="LEFT">+getGroupByToken(...)</TD></TR><TR><TD ALIGN="LEFT">+addExpenseByToken(...)</TD></TR><TR><TD ALIGN="LEFT">+updateExpenseByToken(...)</TD></TR><TR><TD ALIGN="LEFT">+deleteExpenseByToken(...)</TD></TR></TABLE>>];
SupabaseClient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>SupabaseClient</B></TD></TR><TR><TD ALIGN="LEFT">«cliente externo»</TD></TR><TR><TD ALIGN="LEFT">consultas y RPC</TD></TR></TABLE>>];
SharedExpensesService -> SupabaseClient [style=dashed,label="acceso de servicio\ntras validar token"];
}
