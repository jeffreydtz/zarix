digraph G {
graph [rankdir=TB,bgcolor="white",fontname="Arial",pad="0.15",nodesep="0.32",ranksep="0.4",splines=polyline];
node [fontname="Arial",fontsize=20,shape=plain];
edge [fontname="Arial",fontsize=18,color="#475569",arrowsize=0.75];
label="Dominio conceptual: reglas y presupuestos"; labelloc=t; fontsize=22;
Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR></TABLE>>];
Cuenta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>Cuenta</B></TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">politicaSaldo</TD></TR></TABLE>>];
Categoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>Categoria</B></TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">naturaleza</TD></TR></TABLE>>];
ReglaRecurrente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>ReglaRecurrente</B></TD></TR><TR><TD ALIGN="LEFT">frecuencia</TD></TR><TR><TD ALIGN="LEFT">fechaInicial</TD></TR><TR><TD ALIGN="LEFT">fechaFinal</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">importe</TD></TR></TABLE>>];
Ocurrencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>Ocurrencia</B></TD></TR><TR><TD ALIGN="LEFT">fechaVencimiento</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">motivo</TD></TR></TABLE>>];
Movimiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>Movimiento</B></TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">fecha</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">origen</TD></TR></TABLE>>];
Presupuesto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eef2f6"><B>Presupuesto</B></TD></TR><TR><TD ALIGN="LEFT">moneda</TD></TR><TR><TD ALIGN="LEFT">inicio</TD></TR><TR><TD ALIGN="LEFT">fin</TD></TR><TR><TD ALIGN="LEFT">limite</TD></TR></TABLE>>];
Usuario -> Cuenta [dir=none,label="posee\nUsuario 1\nCuenta 0..*"];
Usuario -> Categoria [dir=none,label="define\nUsuario 0..1\nCategoria 0..*"];
Usuario -> ReglaRecurrente [dir=none,label="configura\nUsuario 1\nReglaRecurrente 0..*"];
Usuario -> Presupuesto [dir=none,label="define\nUsuario 1\nPresupuesto 0..*"];
Categoria -> Movimiento [dir=none,label="clasifica\nCategoria 0..1\nMovimiento 0..*"];
ReglaRecurrente -> Ocurrencia [dir=none,label="vence\nReglaRecurrente 1\nOcurrencia 0..*"];
Ocurrencia -> Movimiento [dir=none,label="produce si confirma\nOcurrencia 0..1\nMovimiento 0..1"];
Cuenta -> ReglaRecurrente [dir=none,label="utiliza\nCuenta 1\nReglaRecurrente 0..*"];
Categoria -> Presupuesto [dir=none,label="limita gasto\nCategoria 0..1\nPresupuesto 0..*"];
}
