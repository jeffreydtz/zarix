b4 [shape=box,style="rounded,filled",fillcolor="#e0f2fe",label="«boundary»\nP04 Regla / Presupuesto"];
v [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nAcceso"];
pr [shape=hexagon,style=filled,fillcolor="#fef3c7",label="«control»\nPresupuestos"];
